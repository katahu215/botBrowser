{
  "name": "League17",
  "version": "1.0.8",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node compile.cjs && electron .",
    "build": "node compile.cjs && electron-builder"
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.9.0"
  },
  "build": {
    "appId": "com.yourcompany.liga17",
    "productName": "Лига 17",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "main.jsc",
      "services/**/*.jsc",
      "services/**/*.cjs",
      "preload.js",
      "package.json",
      "!bundle.js",
      "!dist/**",
      "!services/**/*.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "katahu215",
        "repo": "botBrowser",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "bytenode": "^2.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
